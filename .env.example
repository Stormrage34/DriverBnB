# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL connection string. Use a dedicated role with a strong password.
# Production must point at EU-hosted PostgreSQL with TLS enabled.
DATABASE_URL=postgresql://localhost:5432/driverfirst

# Public origin used for metadata and absolute links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
APP_BASE_URL=http://localhost:3000

# Email delivery is disabled until a real provider, DPA and processing location
# are chosen. `test` captures messages in memory and never sends real email.
EMAIL_PROVIDER=disabled

# Only enable when a reverse proxy overwrites X-Forwarded-For / X-Real-IP.
# A direct public deployment must leave this false.
TRUST_PROXY=false

# Enable only on an HTTPS deployment with a verified certificate chain.
ENABLE_HSTS=false

# Bearer secret for POST /api/internal/vacancy-lifecycle. Leave empty to disable the route
# (it returns 503). Generate with: openssl rand -base64 32
VACANCY_LIFECYCLE_SECRET=
