    "vacancies:lifecycle": "tsx src/scripts/vacancy-lifecycle.ts",
    "users:verify-email": "tsx src/scripts/verify-user-email.ts",
    "users:cleanup-tokens": "tsx src/scripts/cleanup-user-tokens.ts"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.4",
    "geist": "^1.6.1",
    "lucide-react": "^0.545.0",
    "next": "16.4.6",
    "postgres": "^3.4.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "drizzle-kit": "^0.31.5",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
